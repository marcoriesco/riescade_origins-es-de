<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <formatVersion>7</formatVersion>

    <view name="screen">

        <!-- Controller Activity -->
        <controllerActivity name="controllerActivity">
            <origin>1 0</origin>
            <pos>0 0.950</pos>
            <size>0.985 0.03</size>
            <itemSpacing>0.003</itemSpacing>
            <imagePath>./resources/indicators/default.svg</imagePath>
            <color>FFFFFF80</color>

            <activityColor ifSubset="colors:white">${white}</activityColor>
            <activityColor ifSubset="colors:pink">${pink}</activityColor>
            <activityColor ifSubset="colors:red">${red}</activityColor>
            <activityColor ifSubset="colors:blue">${blue}</activityColor>
            <activityColor ifSubset="colors:gray">${gray}</activityColor>
            <activityColor ifSubset="colors:green">${green}</activityColor>
            <activityColor ifSubset="colors:purple">${purple}</activityColor>
            <activityColor ifSubset="colors:yellow">${yellow}</activityColor>

            <hotkeyColor ifSubset="colors:white">${white}</hotkeyColor>
            <hotkeyColor ifSubset="colors:pink">${pink}</hotkeyColor>
            <hotkeyColor ifSubset="colors:red">${red}</hotkeyColor>
            <hotkeyColor ifSubset="colors:blue">${blue}</hotkeyColor>
            <hotkeyColor ifSubset="colors:gray">${gray}</hotkeyColor>
            <hotkeyColor ifSubset="colors:green">${green}</hotkeyColor>
            <hotkeyColor ifSubset="colors:purple">${purple}</hotkeyColor>
            <hotkeyColor ifSubset="colors:yellow">${yellow}</hotkeyColor>

            <horizontalAlignment>right</horizontalAlignment>
            <zIndex>99</zIndex>
        </controllerActivity>

        <!-- Clock -->
        <text name="clock">
            <origin>1 0</origin>
            <pos>0.96 0.035</pos>
            <size>0.5 0.1</size>
            <fontPath>./resources/fonts/Roboto-Light.ttf</fontPath>
            <fontSize>0.034</fontSize>
            <color>FFFFFFFF</color>
            <alignment>right</alignment>
        </text>

    </view>

    <view name="menu, system, grid, gamecarousel, detailed">
        <helpsystem name="help">
            <pos>9999</pos>
            <visible>0</visible>
            <opacity>0</opacity>
        </helpsystem>
    </view>

</theme>